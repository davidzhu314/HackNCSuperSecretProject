

GEMINI_API_KEY=
# Model for /api/facts/extract and /api/evaluate
GEMINI_MODEL=gemini-3.8-flash
# Model for /api/rewrite only
GEMINI_REWRITE_MODEL=gemini-3.8-flash
# Optional generation setting; leave empty to use Gemini's default.
GEMINI_TEMPERATURE=

# Without GEMINI_API_KEY, the server falls back to OpenRouter when this is set.
OPENROUTER_API_KEY=
# OpenRouter models (defaults: anthropic/claude-haiku-5.5, anthropic/claude-sonnet-5.5 for rewrites)
OPENROUTER_MODEL=
OPENROUTER_REWRITE_MODEL=
OPENROUTER_TEMPERATURE=
