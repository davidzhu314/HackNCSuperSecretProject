

OPENROUTER_API_KEY=
# Model for /api/facts/extract and /api/evaluate
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Model for /api/rewrite only
OPENROUTER_REWRITE_MODEL=anthropic/claude-sonnet-5.5
# Optional. Leave empty for Anthropic models (Haiku rejects temperature on OpenRouter)
OPENROUTER_TEMPERATURE=
